# ---- Database ----
DB_HOST=your-database-host
DB_PORT=3306
DB_USER=your-database-user
DB_PASSWORD=your-database-password
DB_NAME=lasani

# ---- JWT / Auth ----
# Generate a strong key, e.g. `python -c "import secrets; print(secrets.token_urlsafe(64))"`
SECRET_KEY=change-me-to-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256
AUTH_ENABLED=true

# ---- CORS (comma separated origins, or * for all) ----
CORS_ORIGINS=*

# ---- App ----
APP_NAME=Inam Ur Rehman Commission Shop API
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# ---- Backups ----
BACKUP_DIR=backups
# Full paths help when mysqldump/mysql are not on PATH (common on Windows/macOS)
MYSQLDUMP_PATH=mysqldump
MYSQL_PATH=mysql

# ---- Rate limiting ----
LOGIN_RATE_LIMIT=5/minute
